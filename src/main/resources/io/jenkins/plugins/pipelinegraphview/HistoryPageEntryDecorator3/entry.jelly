<?xml version="1.0" encoding="UTF-8"?>

<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:local="local">
    <!-- A pill styled like the pipeline status icons: tinted fill, faint border, coloured glyph. Hidden when empty. -->
    <d:taglib uri="local">
        <d:tag name="tag">
            <j:if test="${count > 0}">
                <span tooltip="${count} ${label}"
                      data-tooltip-append-to-parent="true"
                      style="display: inline-flex; align-items: center; gap: 0.3rem; height: 22px; padding: 0 0.55rem 0 0.4rem; border-radius: 999px; box-sizing: border-box; color: ${color}; background: color-mix(in srgb, ${color} calc(var(--status-background-opacity, 0.125) * 100%), transparent); border: var(--jenkins-border--inherit-subtle); font-size: 12px; font-variant-numeric: tabular-nums;">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" aria-hidden="true"
                         style="width: 12px; height: 12px; flex-shrink: 0;">
                        <path d="${path}" fill="none" stroke="currentColor" stroke-linecap="round"
                              stroke-linejoin="round" stroke-width="56" />
                    </svg>
                    ${count}
                </span>
            </j:if>
        </d:tag>
    </d:taglib>

    <j:set var="d" value="${it.decorator}" />
    <j:if test="${d.totalCount > 0}">
        <a href="${rootURL + '/' + build.url + 'testReport/'}"
           style="display: inline-flex; flex-direction: column; color: inherit; text-decoration: none;">
            <div style="display: flex; align-items: center; gap: 0.25rem; min-height: 22px; margin-bottom: 3px;">
                <local:tag count="${d.failCount}" label="failed" color="var(--error-color)"
                           path="M368 368L144 144M368 144L144 368" />
                <local:tag count="${d.passCount}" label="passed" color="var(--success-color)"
                           path="M416 128L192 384l-96-96" />
                <local:tag count="${d.skipCount}" label="skipped" color="var(--text-color-secondary)"
                           path="M400 256H112" />
            </div>
            <!-- Change since the previous build, only shown when something changed -->
            <div class="jenkins-!-text-color-secondary"
                 style="display: flex; gap: 0.5rem; font-size: 12px; font-variant-numeric: tabular-nums;">
                <span>${d.totalCount} ${d.totalCount == 1 ? 'test' : 'tests'}</span>
                <j:if test="${d.regressionCount > 0}">
                    <span style="display: inline-flex; align-items: center; gap: 0.2rem;"
                          tooltip="Failing now, passed in the previous build"
                          data-tooltip-append-to-parent="true">
                        <l:icon src="symbol-trending-down-outline plugin-ionicons-api" style="width: 12px; height: 12px; flex-shrink: 0;" />
                        ${d.regressionCount} ${d.regressionCount == 1 ? 'regression' : 'regressions'}
                    </span>
                </j:if>
                <j:if test="${d.fixedCount > 0}">
                    <span style="display: inline-flex; align-items: center; gap: 0.2rem;"
                          tooltip="Passing now, failed in the previous build"
                          data-tooltip-append-to-parent="true">
                        <l:icon src="symbol-trending-up-outline plugin-ionicons-api" style="width: 12px; height: 12px; flex-shrink: 0;" />
                        ${d.fixedCount} fixed
                    </span>
                </j:if>
            </div>
        </a>
    </j:if>
</j:jelly>

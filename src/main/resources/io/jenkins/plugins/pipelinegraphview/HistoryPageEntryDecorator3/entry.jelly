<?xml version="1.0" encoding="UTF-8"?>

<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:local="local">
    <!-- Styles live in src/main/frontend/new-thing/test-summary.scss -->
    <d:taglib uri="local">
        <!-- A pill with a count, hidden when empty -->
        <d:tag name="tag">
            <j:if test="${count > 0}">
                <span class="pgv-test-summary__tag pgv-test-summary__tag--${type}"
                      tooltip="${count} ${type}"
                      data-tooltip-append-to-parent="true">
                    <l:icon src="${icon}" />
                    ${count}
                </span>
            </j:if>
        </d:tag>
    </d:taglib>

    <j:set var="d" value="${it.decorator}" />
    <j:if test="${d.totalCount > 0}">
        <a href="${rootURL + '/' + build.url + 'testReport/'}" class="pgv-test-summary">
            <div class="pgv-test-summary__tags">
                <local:tag count="${d.failCount}" type="failed"
                           icon="symbol-close-outline plugin-ionicons-api" />
                <local:tag count="${d.passCount}" type="passed"
                           icon="symbol-checkmark-outline plugin-ionicons-api" />
                <local:tag count="${d.skipCount}" type="skipped"
                           icon="symbol-play-skip-forward-outline plugin-ionicons-api" />
            </div>
            <!-- Change since the previous build, only shown when something changed -->
            <div class="pgv-test-summary__details">
                <span>${d.totalCount} ${d.totalCount == 1 ? 'test' : 'tests'}</span>
                <j:if test="${d.regressionCount > 0}">
                    <span tooltip="Failing now, passed in the previous build"
                          data-tooltip-append-to-parent="true">
                        <l:icon src="symbol-trending-down-outline plugin-ionicons-api" />
                        ${d.regressionCount} ${d.regressionCount == 1 ? 'regression' : 'regressions'}
                    </span>
                </j:if>
                <j:if test="${d.fixedCount > 0}">
                    <span tooltip="Passing now, failed in the previous build"
                          data-tooltip-append-to-parent="true">
                        <l:icon src="symbol-trending-up-outline plugin-ionicons-api" />
                        ${d.fixedCount} fixed
                    </span>
                </j:if>
            </div>
        </a>
    </j:if>
</j:jelly>
